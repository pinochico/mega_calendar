<% ticket_time = TicketTime.where({:issue_id => @issue.id}).first rescue nil %>
<% time_begin_str = (!ticket_time.blank? && !ticket_time.time_begin.blank?) ? ticket_time.time_begin.strftime('%H:%M') : '' %>
<% time_end_str = (!ticket_time.blank? && !ticket_time.time_end.blank?) ? ticket_time.time_end.strftime('%H:%M') : '' %>
<% if time_begin_str.present? || time_end_str.present? %>
<script type="text/javascript">
$(function(){
  var time_begin = '<%= time_begin_str %>';
  var time_end = '<%= time_end_str %>';
  /* úprava RuB studio: čas vložit hned za datum (před „(Zbývá …)“ a před ikonu rychlé editace), ne na konec hodnoty */
  function pmInsertTime($val, time) {
    var el = $val[0], tn = null;
    for (var i = 0; i < el.childNodes.length; i++) {
      if (el.childNodes[i].nodeType === 3 && $.trim(el.childNodes[i].nodeValue)) { tn = el.childNodes[i]; break; }
    }
    if (!tn) { $val.append(' ' + time); return; }
    var txt = tn.nodeValue, p = txt.indexOf(' (');
    if (p < 0) {
      var trail = txt.match(/\s*$/)[0];
      tn.nodeValue = txt.slice(0, txt.length - trail.length) + ' ' + time + trail;
    } else {
      tn.nodeValue = txt.slice(0, p) + ' ' + time + txt.slice(p);
    }
  }
  if (time_begin) {
    var $start_val = $('.attributes div.start-date .value').first();
    if ($start_val.length) { pmInsertTime($start_val, time_begin); }
  }
  if (time_end) {
    var $due_val = $('.attributes div.due-date .value').first();
    if ($due_val.length) { pmInsertTime($due_val, time_end); }
  }
});
</script>
<% end %>
